---
import Base from "../layouts/Base.astro";
import ThemeCard from "../components/ThemeCard.astro";
import Topbar from "../components/Topbar.astro";
import { loadThemes } from "../lib/themes.ts";
import { TAGS } from "../../../scripts/schema.ts";

const themes = loadThemes();
const usedTags = TAGS.filter((tag) => tag !== "dark" && tag !== "light" && themes.some((t) => t.meta.tags.includes(tag)));
---
<Base
  title="Spotifast Themes"
  description="Free color themes for Spotifast. Pick one you like, download it, and drop it in your themes folder."
  current="home"
>
  <header class="hero">
    <Topbar search />
    <p class="eyebrow">Color themes</p>
    <h1 class="big-title">Make Spotifast yours</h1>
    <p class="lede">
      Pick a look you like, download it, and drop it in your themes folder. That's it.
      Every theme here is free, and made by people who use Spotifast.
    </p>
  </header>

  <div class="main-inner">
    <div class="toolbar">
      <div class="chips" role="group" aria-label="Show">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="chip" type="button" data-filter="base:dark" aria-pressed="false">Dark</button>
        <button class="chip" type="button" data-filter="base:light" aria-pressed="false">Light</button>
        {usedTags.map((tag) => (
          <button class="chip" type="button" data-filter={`tag:${tag}`} aria-pressed="false">
            {tag.charAt(0).toUpperCase() + tag.slice(1).replace("-", " ")}
          </button>
        ))}
      </div>
      <label class="sort">
        Sort by
        <select data-sort>
          <option value="newest">Newest</option>
          <option value="name">A to Z</option>
        </select>
      </label>
    </div>

    <h2 class="section-title" data-count aria-live="polite">{themes.length} themes</h2>

    <ul class="grid" data-grid>
      {themes.map((t) => <ThemeCard theme={t} />)}
    </ul>

    <div class="empty" data-empty hidden>
      <strong>Nothing matches that.</strong>
      Try a different word, or clear the filters.
    </div>
  </div>
</Base>

<script>
  const grid = document.querySelector<HTMLElement>("[data-grid]")!;
  const cards = [...grid.querySelectorAll<HTMLElement>("[data-card]")];
  const search = document.querySelector<HTMLInputElement>("#q");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const sort = document.querySelector<HTMLSelectElement>("[data-sort]")!;
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;

  let filter = "all";

  function matches(card: HTMLElement, words: string[]): boolean {
    const d = card.dataset;
    if (filter.startsWith("base:") && d.base !== filter.slice(5)) return false;
    if (filter.startsWith("tag:") && !(d.tags ?? "").split(" ").includes(filter.slice(4))) return false;
    const haystack = `${d.name} ${d.author} ${d.tags} ${d.base}`;
    return words.every((w) => haystack.includes(w));
  }

  function update() {
    const words = (search?.value ?? "").toLowerCase().replace(/^@/, "").split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const ok = matches(card, words);
      card.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = shown === 1 ? "1 theme" : `${shown} themes`;
    empty.hidden = shown > 0;
  }

  function reorder() {
    const sorted = [...cards].sort((a, b) =>
      sort.value === "name"
        ? (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
        : (b.dataset.added ?? "").localeCompare(a.dataset.added ?? "") ||
          (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""),
    );
    grid.append(...sorted);
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      filter = chip.dataset.filter ?? "all";
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      update();
    }),
  );
  search?.addEventListener("input", update);
  sort.addEventListener("change", reorder);
</script>
