{
  "name": "spotifast-themes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "previews": "tsx scripts/preview.ts",
    "prepare-site": "tsx scripts/prepare-site.ts",
    "build": "pnpm prepare-site && pnpm --filter site build",
    "dev": "pnpm prepare-site && pnpm --filter site dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "obscenity": "0.4.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
